---
import Layout from '../layouts/Layout.astro';
import CategoryList from '../components/CategoryList.vue';
---

<Layout title="Catégories">
  <div class="hero">
    <h1>Bibliothèque des Procédures</h1>
    <p>Sélectionnez une catégorie pour consulter les procédures correspondantes.</p>
  </div>
  
  <CategoryList client:load />
</Layout>

<style>
  .hero {
    text-align: center;
    margin-bottom: 3rem;
  }
  
  .hero h1 {
    font-size: 2.5rem;
    color: var(--text-main);
    margin-bottom: 0.5rem;
  }
  
  .hero p {
    font-size: 1.1rem;
    color: var(--text-muted);
  }
</style>
